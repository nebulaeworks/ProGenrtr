ALIASES += START_SCENARIO="\
<div style='border:1px solid #76ce96;\
            background-color: rgba(204,238,213,0.05);\
            padding:8px;\
            border-radius:4px;\
            margin:6px 0;'>\
<span style=\"font-weight: bold; color: #76ce96;\">\
    SCENARIO:\
</span>"
ALIASES += END_SCENARIO="</div>"
# -----------------------------------o   o------------------------------------ #
#                               GIVEN CONDITIONS                               #
# -----------------------------------o   o------------------------------------ #
ALIASES += GIVEN{1}="\
<div style='border:1px solid #c900ff;\
            background-color:rgba(33,0,69,0.1);\
            padding:8px;\
            border-radius:4px;\
            margin:6px 0;\
            border-left:8px solid #c900ff;'>\
<b style='color:#c900ff;'>GIVEN:</b> \1 </div>"

ALIASES += AND_G{1}="\
<div style='border:1px solid #c900ff;\
            background-color:rgba(33,0,69,0.1);\
            padding:8px;\
            border-radius:4px;\
            margin:6px 0;\
            border-left:8px solid #c900ff;'>\
<b style='color:#c900ff;'>AND:</b> \1 </div>"

ALIASES += OR_G{1}="\
<div style='border:1px solid #c900ff;\
            background-color:rgba(33,0,69,0.1);\
            padding:8px;\
            border-radius:4px;\
            margin:6px 0;\
            border-left:8px solid #c900ff;'>\
<b style='color:#c900ff;'>OR:</b> \1 </div>"
